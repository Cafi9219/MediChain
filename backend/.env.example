# MediChain Environment Configuration Template
# Copy to .env and configure for your local environment

PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Consortium Legacy HMAC Shared Secret (Legacy baseline only; will migrate in Step 1)
# Location: backend/blockchain/cryptoUtils.js (Lines 29, 39)
CONSORTIUM_HMAC_SECRET=dev_fallback_hmac_secret_not_for_production

# Department Access Passwords (Dev defaults shown as documentation; override in production)
DEPT_CIFV_PASSWORD=Pass@cifv2026
DEPT_SROPS_PASSWORD=Pass@srops2026
DEPT_ADMIN_PASSWORD=Pass@admin2026
